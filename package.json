{
  "name": "flop-pilot",
  "version": "0.1.0",
  "description": "Autopilot CLI and local dashboard for FLOP Testnet agents: wallets, faucet claims, enrollment, inference spending.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "flop-pilot": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "vitest run",
    "init": "node dist/cli.js init",
    "init:restore": "node dist/cli.js init --restore",
    "doctor": "node dist/cli.js doctor",
    "wallets": "node dist/cli.js wallets",
    "fund": "node dist/cli.js fund",
    "enroll": "node dist/cli.js enroll",
    "spend": "node dist/cli.js spend",
    "tick": "node dist/cli.js tick",
    "dashboard": "node dist/cli.js dashboard",
    "autopilot:on": "node dist/cli.js autopilot on",
    "autopilot:off": "node dist/cli.js autopilot off",
    "autopilot:status": "node dist/cli.js autopilot status",
    "pause": "node dist/cli.js pause",
    "resume": "node dist/cli.js resume",
    "stop": "node dist/cli.js stop",
    "stop:deactivate": "node dist/cli.js stop --deactivate",
    "practice:on": "node dist/cli.js practice on",
    "practice:off": "node dist/cli.js practice off",
    "network:devnet": "node dist/cli.js network devnet",
    "network:testnet": "node dist/cli.js network testnet",
    "claimers:1": "node dist/cli.js claimers 1",
    "claimers:2": "node dist/cli.js claimers 2",
    "claimers:3": "node dist/cli.js claimers 3",
    "miners:list": "node dist/cli.js miners list",
    "miners:add": "node dist/cli.js miners add",
    "miners:remove": "node dist/cli.js miners remove",
    "activation": "node dist/cli.js activation",
    "update": "node dist/cli.js update",
    "export": "node dist/cli.js export",
    "pilot": "node dist/cli.js",
    "init:passphrase": "node dist/cli.js init --passphrase",
    "autopilot:run": "node dist/cli.js autopilot run",
    "unlock:passphrase": "node dist/cli.js unlock passphrase",
    "unlock:auto": "node dist/cli.js unlock auto"
  },
  "files": [
    "dist",
    "src/spend/builtin-tasks.json",
    "src/dashboard/public"
  ],
  "dependencies": {
    "@flop-labs/sdk": "0.13.1",
    "@hono/node-server": "^2.1.11",
    "@polkadot/api": "17.0.2",
    "@polkadot/keyring": "14.0.3",
    "@polkadot/util": "14.0.3",
    "@polkadot/util-crypto": "14.0.3",
    "better-sqlite3": "^13.2.0",
    "commander": "^15.1.0",
    "diff": "^9.0.0",
    "hono": "^4.13.23"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.11",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
