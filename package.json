{
  "name": "flop-pilot",
  "version": "0.1.0",
  "description": "Autopilot CLI and local dashboard for FLOP Testnet agents: wallets, faucet claims, enrollment, inference spending.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "flop-pilot": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "src/spend/builtin-tasks.json",
    "src/dashboard/public"
  ],
  "dependencies": {
    "@flop-labs/sdk": "0.13.1",
    "@hono/node-server": "^2.1.11",
    "@polkadot/api": "17.0.2",
    "@polkadot/keyring": "14.0.3",
    "@polkadot/util": "14.0.3",
    "@polkadot/util-crypto": "14.0.3",
    "better-sqlite3": "^13.2.0",
    "commander": "^15.1.0",
    "diff": "^9.0.0",
    "hono": "^4.13.23"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.11",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
